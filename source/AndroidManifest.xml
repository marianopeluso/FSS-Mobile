<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.filesecuresuite.mobilelite">

    <!-- USE_BIOMETRIC (install-time, no prompt): fingerprint/face/PIN entry on Android 11+.
         CAMERA (asked only the first time the live QR scanner is opened): frames are analysed in
         memory only, no photo is taken or stored. No Internet, no storage permission. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:label="FSS Mobile"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:label="FSS Mobile">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/x-pem-file" />
                <data android:mimeType="application/x-pem" />
                <data android:mimeType="application/x-x509-ca-cert" />
                <data android:mimeType="application/pkix-cert" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- "Open with" for files received as documents: encrypted .rsa packages and public keys (.pem).
                 Chat and mail apps label a .pem in different ways (PEM, certificate or plain text), so all are
                 listed. The app looks at the content, not at the label: an FSS container is decrypted, a public
                 key opens "Add contact", anything else gets "Nothing to open". -->
            <intent-filter android:label="FSS Mobile">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-pem-file" />
                <data android:mimeType="application/x-pem" />
                <data android:mimeType="application/pem-certificate-chain" />
                <data android:mimeType="application/x-x509-ca-cert" />
                <data android:mimeType="application/x-x509-user-cert" />
                <data android:mimeType="application/pkix-cert" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <provider
            android:name=".ShareProvider"
            android:authorities="org.filesecuresuite.mobilelite.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
